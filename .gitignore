Packages/manifest.json.bak

# ======================================================
# Asset Store content - re-import from the Package Manager
# rather than storing ~1.3 GB of binaries in git.
# See docs/ASSET-STORE-PACKAGES.md for the list.
# KinematicCharacterController and TextMesh Pro are NOT
# ignored: KCC contains local netcode modifications.
# ======================================================
/Assets/Imports/Epic Toon FX/
/Assets/Imports/Epic Toon FX.meta
/Assets/Imports/polyperfect/
/Assets/Imports/polyperfect.meta
/Assets/Imports/PolygonFantasyHeroCharacters/
/Assets/Imports/PolygonFantasyHeroCharacters.meta
/Assets/Imports/PolygonDungeon/
/Assets/Imports/PolygonDungeon.meta
