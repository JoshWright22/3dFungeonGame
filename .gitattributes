# Godot text formats use LF on every platform.
* text=auto eol=lf

*.ps1 text eol=crlf

# Binary art and audio: never diff or merge these.
*.glb   binary
*.fbx   binary
*.blend binary
*.png   binary
*.jpg   binary
*.wav   binary
*.ogg   binary
*.mp3   binary
*.ttf   binary
*.otf   binary
*.dll   binary
*.so    binary
*.dylib binary
